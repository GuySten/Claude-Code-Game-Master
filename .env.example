# DM Claude Configuration

# Campaign Settings
DEFAULT_CAMPAIGN_NAME="My Campaign"
DEFAULT_STARTING_LOCATION="Thornwick"

# Optional: Discord webhook for session logging
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: pictures (see GAME-NIGHT.md -> 5. Pictures). Either an OpenAI key...
# OPENAI_API_KEY=sk-...
# ...or a local Stable Diffusion WebUI Forge started with --api (free, needs an NVIDIA GPU):
# IMAGE_BACKEND=forge
# ...or a local ComfyUI (NVIDIA or AMD), see GAME-NIGHT.md -> 5. Pictures:
# IMAGE_BACKEND=comfyui
# COMFY_MODEL=dreamshaperXL_lightningDPMSDE.safetensors
# FORGE_URL=http://127.0.0.1:7860
# ...or that Forge on the host's laptop, when the game runs elsewhere (a cloud session;
# see CLOUD-TABLE.md). The laptop runs: bash tools/gm-gpu-server.sh, plus a tunnel.
# GPU_SERVER_URL=https://something.trycloudflare.com
# GPU_SERVER_PASSWORD=the password gm-gpu-server.sh printed
